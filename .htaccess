DirectoryIndex index.php
ErrorDocument 404 /404.php
Options -Indexes
ServerSignature Off

# Never expose server-side includes or project metadata.
<FilesMatch "^(\\.env|\\.git|composer\\.(json|lock)|package(-lock)?\\.json|tsconfig\\.json|phpunit\\.xml|README.*)$">
Require all denied
</FilesMatch>

AddDefaultCharset UTF-8

RewriteEngine On

# Direct sitemap access and sitemap aliases from every page path.
RewriteRule ^(?:.*?/)?sitemap\.xml$ sitemap.xml [NC,L]

# Clean application routes. Both /Page and /Page/ resolve.
RewriteRule ^$ index.php [L]
RewriteRule ^About/?$ about.php [L]
RewriteRule ^Architecture/?$ architecture.php [L]
RewriteRule ^Documentation/?$ documentation.php [L]
RewriteRule ^Docs/?$ /Documentation/ [R=301,L]
RewriteRule ^Roadmap/?$ roadmap.php [L]
RewriteRule ^Updates/?$ updates.php [L]
RewriteRule ^FAQ/?$ faq.php [L]
RewriteRule ^Developer/?$ developer.php [L]

# Redirect old direct PHP URLs to the public clean URLs.
RewriteCond %{THE_REQUEST} \s/+about\.php(?:[?\s]) [NC]
RewriteRule ^about\.php$ /About/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+architecture\.php(?:[?\s]) [NC]
RewriteRule ^architecture\.php$ /Architecture/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+docs\.php(?:[?\s]) [NC]
RewriteRule ^docs\.php$ /Documentation/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+roadmap\.php(?:[?\s]) [NC]
RewriteRule ^roadmap\.php$ /Roadmap/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+updates\.php(?:[?\s]) [NC]
RewriteRule ^updates\.php$ /Updates/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+faq\.php(?:[?\s]) [NC]
RewriteRule ^faq\.php$ /FAQ/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+developer\.php(?:[?\s]) [NC]
RewriteRule ^developer\.php$ /Developer/ [R=301,L]

<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'none'; font-src 'self' data:;"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "\.(md|json|ts)$">
Require all denied
</FilesMatch>
