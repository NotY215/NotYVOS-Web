DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes
ServerSignature Off
AddDefaultCharset UTF-8
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://ppsx33.xo.je%{REQUEST_URI} [R=301,L]
RewriteRule ^Docs/?$ /Documentation/ [R=301,L,NC]
RewriteRule ^About/?$ about.html [L,NC]
RewriteRule ^Architecture/?$ architecture.html [L,NC]
RewriteRule ^Documentation/?$ documentation.html [L,NC]
RewriteRule ^Roadmap/?$ roadmap.html [L,NC]
RewriteRule ^Updates/?$ updates.html [L,NC]
RewriteRule ^FAQ/?$ faq.html [L,NC]
RewriteRule ^Developer/?$ developer.html [L,NC]
<FilesMatch "^(.env|.git|composer.(json|lock)|package(-lock)?.json|tsconfig.json|phpunit.xml|README.*)$">
Require all denied
</FilesMatch>
<FilesMatch ".(md|json|ts)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set Cache-Control "public, max-age=300"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
